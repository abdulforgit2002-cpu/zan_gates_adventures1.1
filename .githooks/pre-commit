#!/bin/sh
# Simple pre-commit hook to prevent committing .env or obvious secrets.
# Install by running: git config core.hooksPath .githooks

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

for file in $STAGED_FILES; do
  if [ "$file" = ".env" ] || [ "$file" = "backend/.env" ] || [ "$file" = "frontend/.env" ]; then
    echo "Error: .env files must not be committed." >&2
    exit 1
  fi

  # Check staged content for common secret keywords
  if git show :"$file" 2>/dev/null | grep -E "JWT_SECRET|DB_PASSWORD|PASSWORD=|API_KEY|SECRET_KEY|AWS_SECRET|ACCESS_KEY" >/dev/null; then
    echo "Error: Potential secret found in staged file: $file" >&2
    echo "Please remove secrets and use environment variables or secret store." >&2
    exit 1
  fi
done

exit 0
