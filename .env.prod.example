# Copy this file to ~/zan-gates-deploy/.env on the server and fill in real
# values. This file is never touched by CI — it's server-only and stays put
# across deploys.

# --- Database (Postgres container credentials) ---
# These initialize the Postgres container on its FIRST run only. Changing
# DB_PASSWORD later does not change the already-initialized database.
DB_NAME=zan_gates_db
DB_USER=zan_gates_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Authentication ---
# Must be at least 32 characters (backend/src/Security/AuthConfig.php enforces this).
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGIN=https://zanzibargates.co.tz,https://www.zanzibargates.co.tz

# --- First admin account ---
# Used only once, by backend/scripts/seed_admin.php, to create the first
# row in `users` when the table is empty (a fresh database). Ignored on
# every deploy after that — there's no in-app password change yet, so
# rotating it later means updating the `users` row directly.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_FULL_NAME=Site Admin
